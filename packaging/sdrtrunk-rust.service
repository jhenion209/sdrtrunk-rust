[Unit]
Description=SDRTrunk-Rust P25 receiver and web UI
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/sdrtrunk-rust serve
User=jordan
# Web settings (SDRTRUNK_HTTPS, SDRTRUNK_HTTP, certificates, trusted proxies); optional. Root-owned, mode 600.
EnvironmentFile=-/etc/sdrtrunk-rust/sdrtrunk-rust.env
# HTTPS on port 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
SupplementaryGroups=plugdev
# Creates /var/lib/sdrtrunk-rust owned by the service user; the database lives there.
StateDirectory=sdrtrunk-rust
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
